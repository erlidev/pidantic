{
	"name": "pidantic",
	"version": "0.1.1",
	"type": "module",
	"private": true,
	"packageManager": "npm@10.9.8",
	"engines": {
		"node": ">=22.19.0"
	},
	"description": "A Pi package of nine extensions: web research, command approval, safety modes, plan mode, blocking subagents, interruption handling, scratch space, and terminal UI tweaks.",
	"license": "MIT",
	"author": "Eric <icemastereric@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/erlidev/pidantic.git"
	},
	"homepage": "https://github.com/erlidev/pidantic#readme",
	"bugs": {
		"url": "https://github.com/erlidev/pidantic/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pidantic"
	],
	"pi": {
		"extensions": [
			"./localsearch/index.ts",
			"./plan-mode/index.ts",
			"./safety/index.ts",
			"./confirm-bash/index.ts",
			"./stop/index.ts",
			"./ui-tweaks/index.ts",
			"./subagent/index.ts",
			"./scratchpad/index.ts",
			"./smart-compaction/index.ts"
		]
	},
	"scripts": {
		"check": "npm run typecheck && npm test",
		"test": "node --test \"*/test/*.test.ts\"",
		"test:watch": "node --test --watch \"*/test/*.test.ts\"",
		"typecheck": "tsc",
		"smoke": "node localsearch/test/smoke.ts",
		"smoke:subagent": "node subagent/test/smoke.ts",
		"smoke:sandbox": "node safety/test/sandbox-smoke.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.84.2",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"typebox": "^1.3.7"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"jsdom": "^30.0.1",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.2",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"@types/node": "^22.0.0",
		"@types/jsdom": "^30.0.0",
		"@types/turndown": "^5.0.6",
		"typebox": "^1.3.7",
		"typescript": "^5.9.0"
	}
}
