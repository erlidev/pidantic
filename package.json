{
	"name": "pi-extensions",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"description": "A local collection of extensions for the pi coding agent.",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./localsearch/index.ts",
			"./plan-mode/index.ts",
			"./smart-compaction/index.ts",
			"./questions/index.ts"
		]
	},
	"scripts": {
		"test": "node --test localsearch/test/*.test.ts",
		"smoke": "node localsearch/test/smoke.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"jsdom": "^30.0.1",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/turndown": "^5.0.6"
	}
}
